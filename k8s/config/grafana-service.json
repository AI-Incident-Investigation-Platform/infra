      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app,method,path) (rate(http_requests_total{namespace=~\"$namespace\",app=~\"$service\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{method}} {{path}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
