        "y": 42,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(auth_password_duration_seconds_bucket{namespace=~\"$namespace\",app=~\"$service\",pod=~\"$pod\",operation=\"verify\",stage=\"wait\"}[$__rate_interval])))",
          "legendFormat": "Ожидание слота",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
