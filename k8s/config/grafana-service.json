    {
      "id": 8,
      "title": "Ошибки приложения по коду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app,code,status) (rate(app_errors_total{namespace=~\"$namespace\",app=~\"$service\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{status}} {{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
