      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app,status) (rate(http_requests_total{namespace=~\"$namespace\",app=~\"$service\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{status}}",
