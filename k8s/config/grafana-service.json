        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,app,method,path) (rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\",app=~\"$service\",pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "{{app}} {{method}} {{path}}",
          "datasource": {
            "type": "prometheus",
