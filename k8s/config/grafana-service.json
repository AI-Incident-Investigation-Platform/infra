          "legendFormat": "Argon2",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(auth_password_duration_seconds_bucket{namespace=~\"$namespace\",app=~\"$service\",pod=~\"$pod\",operation=\"verify\",stage=\"total\"}[$__rate_interval])))",
          "legendFormat": "Вся проверка",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
